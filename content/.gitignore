# Сгенерированные медиа воспроизводятся командой `npm run alovlab -- reel <дата>`,
# поэтому в git их не тащим. Оставляем текстовые артефакты: планы, сценарии,
# субтитры, payload/response, статус — они показывают структуру и результат.
**/render/
**/segments/
**/broll/
**/carousel/*.png
**/*.mp4
**/*.mp3
**/*.wav
