# ─────────────────────────────────────────────────────────────
# AlovLab Automation — переменные окружения
# Скопируй в .env и заполни. Реальные ключи в git НЕ попадают
# (см. .gitignore: .env и .env.* игнорируются, кроме .env.example).
# Ключи живут ТОЛЬКО локально/на бэкенде и никогда не логируются целиком.
# ─────────────────────────────────────────────────────────────

# Где хранятся дни производства (папки content/YYYY-MM/YYYY-MM-DD/…)
CONTENT_ROOT=content

# ── HeyGen (аватар Нейромонах) ───────────────────────────────
HEYGEN_API_KEY=
HEYGEN_API_BASE=https://api.heygen.com
# Постоянный аватар и голос. Без них тулинг покажет понятную ошибку
# «Добавь HEYGEN_AVATAR_ID и HEYGEN_VOICE_ID» и не запустит генерацию.
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
HEYGEN_DEFAULT_LANGUAGE=ru
HEYGEN_DEFAULT_ENGINE=
HEYGEN_WEBHOOK_SECRET=
# true — реальные запросы НЕ уходят, кредиты не тратятся, статусы проходят тот же
# путь, возвращается локальный тестовый MP4. В production должно быть false.
HEYGEN_MOCK_MODE=true

# ── Grok / xAI (генерация недостающего B-roll, text/image-to-video) ──
XAI_API_KEY=
XAI_API_BASE=https://api.x.ai
XAI_VIDEO_MODEL=grok-imagine-video
XAI_VIDEO_RESOLUTION=720p
XAI_VIDEO_ASPECT_RATIO=9:16
XAI_VIDEO_MOCK_MODE=true
# Реальные endpoints НЕ выдуманы: задай их ТОЛЬКО после сверки с официальной
# документацией xAI. Пока пусто — реальный запуск честно останавливается.
XAI_VIDEO_ENDPOINT=
XAI_VIDEO_STATUS_ENDPOINT=

# ── Higgsfield (оживление кадров, cinematic B-roll) ──────────
# Подключается через MCP в самом Claude Code (mcp.higgsfield.ai/mcp),
# а не через ключ здесь. Флаг нужен только для оффлайн-прогона пайплайна.
HIGGSFIELD_MOCK_MODE=true

# ── Лимиты генерации ─────────────────────────────────────────
# Если расчётная стоимость превышает лимит — платная генерация не запускается.
MAX_VIDEO_GENERATION_COST_USD=
# Максимум попыток на одну сцену (временные ошибки). Без бесконечных повторов.
VIDEO_GENERATION_MAX_RETRIES=2
# Разрешена ли автоматическая платная генерация в команде «Сделай ролик».
ALLOW_AUTO_GENERATE=true

# ── FFmpeg (монтаж) ──────────────────────────────────────────
# Пусто — ищем в PATH, затем бинарь из Playwright.
FFMPEG_PATH=
FFPROBE_PATH=

# ── LLM для сценария/карусели (опционально) ──────────────────
# template — рабочий офлайн-движок, ключ не нужен. anthropic — реальная модель.
LLM_PROVIDER=template
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

DATA_DIR=./data
