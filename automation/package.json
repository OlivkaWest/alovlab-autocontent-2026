{
  "name": "alovlab-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Date-driven Claude Code toolkit for AlovLab: дата → контент дня → сценарий Reels → сцены → HeyGen / Higgsfield / Grok → монтаж FFmpeg → готовый вертикальный MP4. Никакого веб-приложения — только CLI, файлы и API.",
  "license": "UNLICENSED",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "alovlab": "dist/bin/alovlab.js"
  },
  "scripts": {
    "alovlab": "tsx bin/alovlab.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "dotenv": "^16.4.5",
    "playwright-core": "^1.49.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/node": "^20.17.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
